# Marine Bio Explorer Environment Configuration

# Session & Authentication Secret
SESSION_SECRET="change-this-to-a-strong-random-session-secret-at-least-32-chars"

# Administrator Setup
# Used to authorize the creation of the first administrator account via UI or CLI
ADMIN_SETUP_SECRET="marine-bio-admin-secret-key-change-me"

# Optional: Initial admin credentials automatically provisioned on first launch if no admin exists
INITIAL_ADMIN_EMAIL="admin@marinebio.org"
INITIAL_ADMIN_PASSWORD="SecureMarineExplorer2026!"

# Database Configuration
# Relational persistent SQLite database file path
DATABASE_PATH="./data/marinebio.db"

# Media Storage Configuration
# Options: 'local' (development / single-server) or 's3' (production object storage)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="25"

# Production S3 / Object Storage (if STORAGE_DRIVER is 's3')
# S3_ENDPOINT="https://..."
# S3_REGION="auto"
# S3_BUCKET="marine-bio-media"
# S3_ACCESS_KEY_ID="your-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-key"

# AI Studio runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
